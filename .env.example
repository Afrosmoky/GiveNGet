# ─────────────────────────────────────────────────────────────
#  Biovlo — KANONICZNA lista zmiennych środowiskowych
#
#  Ten plik JEST commitowany i zawiera wyłącznie placeholdery.
#  Pliki .env, .env.local i .env.demo są w .gitignore i trzymają
#  prawdziwe wartości.
#
#  Użycie:  cp .env.example .env  &&  uzupełnij wartości
#           docker compose up -d --build
#
#  Backend bez Dockera (`mvn spring-boot:run`) NIE czyta tego pliku —
#  te same zmienne trzeba wyeksportować w powłoce, np.:
#     set -a && source .env && set +a
# ─────────────────────────────────────────────────────────────

# ── Adresy ────────────────────────────────────────────────────
# URL frontendu — używany w linkach w mailach (aktywacja, reset hasła)
FRONT_APP_URL=http://localhost:3000
# URL backendu "wypalany" w bundle Next.js podczas budowania obrazu
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development

# ── CORS (WYMAGANE) ───────────────────────────────────────────
# Lista dozwolonych originów po przecinku, bez ukośnika na końcu.
# Jedno źródło prawdy dla HTTP i WebSocket. Wildcard "*" jest ZABRONIONY —
# aplikacja odrzuci go na starcie.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Sekrety (WYMAGANE — brak = aplikacja nie wstanie) ─────────
# Sekret podpisujący tokeny JWT. Min. 32 znaki (HS256 = 256 bitów).
# Wygeneruj własny:  openssl rand -hex 48
# UWAGA: zmiana tej wartości unieważnia wszystkie aktywne tokeny (wylogowanie).
JWT_SECRET=zmien-mnie-openssl-rand-hex-48

# Konto SMTP do maili aktywacyjnych i powiadomień
SMTP_USERNAME=konto@example.com
SMTP_PASSWORD=haslo-aplikacji-smtp

# Klucz API Geoapify (geokodowanie + kafle mapy)
GEOAPIFY_KEY=twoj-klucz-geoapify

# ── Baza danych ───────────────────────────────────────────────
# W profilu `local` mają wartości domyślne (user/password) pasujące do
# lokalnego docker-compose. W profilu `dev` są WYMAGANE.
DB_USERNAME=gnguser123
DB_PASSWORD=zmien-mnie

# ── Limity tempa (opcjonalne — mają wartości domyślne) ────────
# Licznik jest w pamięci procesu: działa dla JEDNEJ instancji aplikacji.
# Okresy w formacie ISO-8601 (PT1H = godzina, PT1M = minuta).
# RATELIMIT_RESERVATION_CREATE_CAPACITY=10
# RATELIMIT_RESERVATION_CREATE_PERIOD=PT1H
# RATELIMIT_RESERVATION_COLLECT_CAPACITY=30
# RATELIMIT_RESERVATION_COLLECT_PERIOD=PT1M
# RATELIMIT_LOGIN_CAPACITY=10
# RATELIMIT_LOGIN_PERIOD=PT1M
# RESERVATION_MAX_ACTIVE_PER_USER=5

# ── Rezerwacje i raport (opcjonalne — mają wartości domyślne) ──
# RESERVATION_HOLD_TTL_HOURS=24
# Push przed końcem holdu i przypomnienie po otwarciu okna odbioru (minuty)
# RESERVATION_EXPIRY_WARNING_BEFORE_MINUTES=120
# RESERVATION_PICKUP_REMINDER_MIN_AGE_MINUTES=30
# REPORT_AVG_WEIGHT_KG_PER_UNIT=0.4
# REPORT_CO2_FACTOR_KG_PER_KG=2.5

# ── Powiadomienia push (FCM, projekt Firebase givenget-b5ef0) ──
# Klucz serwisowy (JSON z konsoli Firebase → Ustawienia projektu → Konta usługi).
# NIGDY w repo ani w obrazie — backend/.dockerignore go wyklucza.
#
# Docker: plik na HOŚCIE montowany do kontenera (domyślnie poniższa ścieżka).
#   Uwaga: jeśli pliku nie ma, Docker utworzy w tym miejscu pusty KATALOG — backend wstanie
#   z wyłączonymi pushami, ale katalog trzeba potem usunąć przed wgraniem klucza.
# FIREBASE_CREDENTIALS_FILE=./backend/src/main/resources/serviceAccountKey.json
#
# Uruchomienie bez Dockera (mvn spring-boot:run): ścieżka czytana bezpośrednio przez backend.
# Pusto = pushe wyłączone, aplikacja działa normalnie.
# FIREBASE_CREDENTIALS_PATH=src/main/resources/serviceAccountKey.json
